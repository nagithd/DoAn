[Unit]
Description=DOFBOT TensorRT Battery Inference (Monitor Only)
After=network.target

[Service]
Type=simple
User=jetson
Group=jetson
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_MODULE_LOADING=LAZY
ExecStart=/usr/bin/python3 -u /home/jetson/dofbot_trt_inference.py --engine /home/jetson/models/dofbot_battery_yolov8n_512_fp16.engine --host 0.0.0.0 --port 7101 --confidence 0.45 --iou 0.50 --warmup-runs 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
