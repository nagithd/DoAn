<Window x:Class="WpfApp3.Dialogs.AIDetectionResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows AI Result"
        Width="960"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#CCCCCC">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#3E3E42"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="HintText" Color="#858585"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HintText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IMITECH Camera AI Result"
                           Foreground="{StaticResource PrimaryText}"
                           FontSize="21"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding ModelStatus}"
                           Foreground="{StaticResource HintText}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#333337"
                    CornerRadius="4"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding OverallResultStatus}"
                           Foreground="{StaticResource PrimaryText}"
                           FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="0"
                    Margin="0,0,12,0">
                <Grid Background="#181818">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="No AI result available"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="The Windows AI service will provide the image, class and bounding box here."
                                   Foreground="{StaticResource HintText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="ImageCanvas"
                                Width="640"
                                Height="480"
                                Background="Transparent">
                            <Image x:Name="InspectionImage"
                                   Source="{Binding InspectionImage}"
                                   Stretch="Fill"
                                   Canvas.Left="0"
                                   Canvas.Top="0"
                                   Width="640"
                                   Height="480"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Inference output"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Detected class" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding DetectedClass}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Confidence" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Score, StringFormat={}{0:P1}}"
                               Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Routing action" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding SelectedRobotCycle}"
                               Style="{StaticResource ValueStyle}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Inference time" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding InferenceTime}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Processed at" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding InspectionTime}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Defect classes select one of three robot cycles. A normal battery uses PASS and continues to the end of the conveyor without a robot pick. The DOFBOT camera controls when routing is triggered."
                               Foreground="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse x:Name="StatusIndicator"
                         Width="14"
                         Height="14"
                         Margin="0,0,8,0"/>
                <TextBlock Text="{Binding OverallResultStatus}"
                           Foreground="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Save image"
                    Command="{Binding SaveImageCommand}"
                    Width="110"
                    Height="38"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="Close"
                    Click="CloseButton_Click"
                    Width="90"
                    Height="38"/>
        </Grid>
    </Grid>
</Window>
