<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp3.Controls"
        Title="Battery Inspection System - Industrial HMI"
        Background="{StaticResource WindowBackground}"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Height="900" Width="1400">

    <!-- Shared styles are loaded from the ResourceDictionaries in App.xaml. -->
    <Grid x:Name="LayoutViewport"
          Margin="12"
          ClipToBounds="True">
        <Grid x:Name="ScalableLayoutRoot"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="BATTERY INSPECTION SYSTEM"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SystemStartupStatus"
                           Grid.Column="1"
                           Text="System not initialized"
                           Foreground="{StaticResource HintTextBrush}"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="12,0"/>
                <Button x:Name="StartSystemButton"
                        Grid.Column="2"
                        Content="START"
                        Click="StartSystemButton_Click"
                        Style="{StaticResource SuccessButton}"
                         MinWidth="170"
                         Height="48"/>
                <Button x:Name="StopSystemButton"
                        Grid.Column="3"
                        Content="STOP"
                        Click="StopSystemButton_Click"
                        Style="{StaticResource DangerButton}"
                        MinWidth="170"
                        Height="48"
                        Margin="8,0,0,0"/>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource HmiTabItemStyle}"/>
                    <Style TargetType="TabPanel">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                </TabControl.Resources>
                <!-- WINDOWS AI CAMERA TAB -->
                <TabItem Header="HOME">
                    <Grid Margin="22">
                        <!-- Camera controls, live image and camera-tab information -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- LEFT PANEL: CameraView stretches to fill available space -->
                            <Border Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Style="{StaticResource CardStyle}"
                                    Padding="0"
                                    Margin="0,0,12,0">

                                <controls:CameraView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>

                            <!-- CENTRE: latest inference is updated automatically. -->
                            <controls:AIDetectionResultView
                                Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Margin="0,0,12,0"
                                Result="{Binding LastInspectionResult}"
                                AiServiceStatus="{Binding AiServiceStatus}"
                                CheckAiServiceCommand="{Binding CheckAiServiceCommand}"/>

                            <!-- RIGHT: controls-->
                            <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="230"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="CAMERA" Style="{StaticResource CardTitleStyle}"/>

                                        <StackPanel Grid.Row="1">
                                            <ComboBox x:Name="CameraListCombo"
                                                          Margin="0,0,0,8"
                                                          ItemsSource="{Binding AvailableCameras}"
                                                          SelectedItem="{Binding SelectedCameraName}"/>
                                            <Button Content="Refresh"
                                                        Style="{StaticResource NeutralButton}"
                                                        Command="{Binding RefreshCommand}"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                            Content="Start"
                                                            Margin="0,0,4,0"
                                                            Command="{Binding ConnectCommand}"
                                                            Style="{StaticResource PrimaryButton}"/>
                                                <Button Grid.Column="1"
                                                            Content="Stop"
                                                            Margin="4,0,0,0"
                                                            Command="{Binding DisconnectCommand}"
                                                            Style="{StaticResource DangerButton}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                           Text="CONVEYOR"
                                           Style="{StaticResource CardTitleStyle}"
                                           Margin="0,0,0,10"/>

                                        <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                            <controls:ConveyorControlView
                                        x:Name="ConveyorControl"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- COMBINED DOFBOT WORKSPACE -->
                <TabItem Header="DOFBOT">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <controls:VisionTriggerView
                            x:Name="VisionTriggerControl"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    </Grid>
                </TabItem>

                <!-- SYSTEM WORKFLOW / CONVEYOR PREVIEW -->
                <TabItem Header="Conveyor">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="420"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <controls:SystemWorkflowDiagram Grid.Row="0"
                                                         Grid.Column="0"
                                                         Margin="0,0,12,12"/>

                        <Grid Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,0,12,0">
                            <!-- Shared log is the source of truth for the
                                 workflow timeline shown here. -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SystemLogEntryCount, StringFormat={}{0} events}"
                                                   Style="{StaticResource LabelStyle}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <ListBox Grid.Row="1"
                                             x:Name="WorkflowLogList"
                                             ItemsSource="{Binding SessionSystemLog}"
                                             Style="{StaticResource SystemLogListStyle}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
