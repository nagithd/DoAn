<UserControl x:Class="WpfApp3.Controls.StatisticsCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Cards Grid - 3 Columns, 2 Rows -->
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

            <!-- Good Card -->
            <Border Background="#2D2D30" CornerRadius="6" MinWidth="140" Margin="8">
                <Grid Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="GoodIcon"
                                   Text="✓"
                                   FontSize="28"
                                   TextAlignment="Center"
                                   Foreground="#4EC9B0"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="GoodLabel"
                                   Text="Good"
                                   Foreground="#858585"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="GoodValue"
                                   Text="0"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="GoodTrend"
                                   Text="↑ 0 today"
                                   Foreground="#4EC9B0"
                                   FontSize="10"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scratch Card -->
            <Border Background="#2D2D30" CornerRadius="6" MinWidth="140" Margin="8">
                <Grid Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScratchIcon"
                                   Text="⚠"
                                   FontSize="28"
                                   TextAlignment="Center"
                                   Foreground="#FFB86C"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="ScratchLabel"
                                   Text="Scratch"
                                   Foreground="#858585"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="ScratchValue"
                                   Text="0"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="ScratchTrend"
                                   Text="↑ 0 today"
                                   Foreground="#FFB86C"
                                   FontSize="10"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dent Card -->
            <Border Background="#2D2D30" CornerRadius="6" MinWidth="140" Margin="8">
                <Grid Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="DentIcon"
                                   Text="◆"
                                   FontSize="28"
                                   TextAlignment="Center"
                                   Foreground="#F47171"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="DentLabel"
                                   Text="Dent"
                                   Foreground="#858585"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="DentValue"
                                   Text="0"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="DentTrend"
                                   Text="↑ 0 today"
                                   Foreground="#F47171"
                                   FontSize="10"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Other Card -->
            <Border Background="#2D2D30" CornerRadius="6" MinWidth="140" Margin="8">
                <Grid Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="OtherIcon"
                                   Text="●"
                                   FontSize="28"
                                   TextAlignment="Center"
                                   Foreground="#8B8B8B"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="OtherLabel"
                                   Text="Other"
                                   Foreground="#858585"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="OtherValue"
                                   Text="0"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="OtherTrend"
                                   Text="↑ 0 today"
                                   Foreground="#8B8B8B"
                                   FontSize="10"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Total Card -->
            <Border Background="#2D2D30" CornerRadius="6" MinWidth="140" Margin="8">
                <Grid Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalIcon"
                                   Text="📊"
                                   FontSize="28"
                                   TextAlignment="Center"
                                   Foreground="#569CD6"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalLabel"
                                   Text="Total"
                                   Foreground="#858585"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TotalValue"
                                   Text="0"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TotalTrend"
                                   Text="↑ 0 today"
                                   Foreground="#569CD6"
                                   FontSize="10"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Today's Production Card -->
            <Border Background="#2D2D30" CornerRadius="6" MinWidth="140" Margin="8">
                <Grid Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ProductionIcon"
                                   Text="⚙"
                                   FontSize="28"
                                   TextAlignment="Center"
                                   Foreground="#CE9178"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProductionLabel"
                                   Text="Today's Production"
                                   Foreground="#858585"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="ProductionValue"
                                   Text="0"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="ProductionTrend"
                                   Text="↑ 0 today"
                                   Foreground="#CE9178"
                                   FontSize="10"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </WrapPanel>
    </Grid>
</UserControl>
