<UserControl x:Class="WpfApp3.Controls.EventLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D30" CornerRadius="8" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Event Log"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="14"
                       FontWeight="Bold"
                       Padding="12,10,12,8"
                       Background="#1E1E1E"/>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1"
                      x:Name="EventDataGrid"
                      Background="#252526"
                      Foreground="#CCCCCC"
                      BorderThickness="0"
                      RowBackground="#252526"
                      AlternatingRowBackground="#2D2D30"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3E3E42"
                      VerticalGridLinesBrush="Transparent"
                      Margin="0">
                
                <!-- Header Style -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.Resources>

                <!-- Columns -->
                <DataGrid.Columns>
                    <!-- Time Column -->
                    <DataGridTextColumn Header="Time" 
                                        Binding="{Binding Time}" 
                                        Width="120"/>

                    <!-- Event Column -->
                    <DataGridTextColumn Header="Event" 
                                        Binding="{Binding Event}" 
                                        Width="*"/>

                    <!-- Type Column -->
                    <DataGridTextColumn Header="Type" 
                                        Binding="{Binding Type}" 
                                        Width="100"/>

                    <!-- Status Column -->
                    <DataGridTextColumn Header="Status" 
                                        Binding="{Binding Status}" 
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
