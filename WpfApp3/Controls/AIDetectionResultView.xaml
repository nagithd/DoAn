<UserControl x:Class="WpfApp3.Controls.AIDetectionResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp3.Controls"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent">
    <Border Style="{StaticResource CardStyle}"
            Padding="0"
            ClipToBounds="True">
        <Grid DataContext="{Binding ViewModel,
                    RelativeSource={RelativeSource AncestorType={x:Type local:AIDetectionResultView}}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="{StaticResource SecondaryBackground}"
                        CornerRadius="4"
                        Padding="9,7"
                        Margin="0,9,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI service"
                                       Foreground="{StaticResource HintTextBrush}"
                                       FontSize="18"/>
                            <TextBlock Text="{Binding AiServiceStatus,
                                RelativeSource={RelativeSource AncestorType={x:Type local:AIDetectionResultView}}}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Check"
                                Command="{Binding CheckAiServiceCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:AIDetectionResultView}}}"
                                Style="{StaticResource NeutralButton}"
                                MinWidth="100"
                                Height="46"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="#181818"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="18">
                        <TextBlock Text="No AI result available"
                                   Foreground="#A0A0A0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="ImageCanvas"
                                Width="640"
                                Height="480"
                                Background="Transparent">
                            <Image x:Name="InspectionImage"
                                   Source="{Binding InspectionImage}"
                                   Canvas.Left="0"
                                   Canvas.Top="0"
                                   Width="640"
                                   Height="480"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.0*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Class" Style="{StaticResource AiResultLabelStyle}"/>
                    <TextBlock Text="{Binding DetectedClass}"
                               Style="{StaticResource AiResultValueStyle}"
                               Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Confidence" Style="{StaticResource AiResultLabelStyle}"/>
                    <TextBlock Text="{Binding Score, StringFormat={}{0:P1}}"
                               Style="{StaticResource AiResultValueStyle}"
                               Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Routing" Style="{StaticResource AiResultLabelStyle}"/>
                    <TextBlock Text="{Binding SelectedRobotCycle}"
                               Style="{StaticResource AiResultValueStyle}"
                               FontSize="20"
                               TextWrapping="Wrap"
                               Margin="0"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</UserControl>
