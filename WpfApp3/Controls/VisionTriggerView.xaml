<UserControl x:Class="WpfApp3.Controls.VisionTriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="VisionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactStatusLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CompactStatusValue" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connection, camera commands and health values share one compact strip. -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Jetson monitor address"
                                   Style="{StaticResource CompactStatusLabel}"/>
                        <TextBox Text="{Binding RobotBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VisionTextBoxStyle}"
                                 Height="42"
                                 Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,0">
                        <Button Content="Connect"
                                Command="{Binding ConnectCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="120"
                                Margin="0,0,8,0"/>
                        <Button Content="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                Style="{StaticResource NeutralButton}"
                                Width="145"/>
                    </StackPanel>

                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Connection" Style="{StaticResource CompactStatusLabel}"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource CompactStatusValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Vision running" Style="{StaticResource CompactStatusLabel}"/>
                        <TextBlock Text="{Binding VisionRunning}" Style="{StaticResource CompactStatusValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Camera open" Style="{StaticResource CompactStatusLabel}"/>
                        <TextBlock Text="{Binding CameraOpen}" Style="{StaticResource CompactStatusValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Frames processed" Style="{StaticResource CompactStatusLabel}"/>
                        <TextBlock Text="{Binding FrameCount}" Style="{StaticResource CompactStatusValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Processing mode" Style="{StaticResource CompactStatusLabel}"/>
                        <TextBlock Text="TensorRT monitor-only"
                                   Style="{StaticResource CompactStatusValue}"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- A responsive 60/40 split matches the small 4:3 DOFBOT camera better. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="0"
                    Margin="0,0,12,0">
                <Grid Background="#181818">
                    <TextBlock Text="Start vision monitoring to view the DOFBOT camera"
                               Foreground="#FFE2E2E2"
                               FontSize="24"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image Source="{Binding RemoteFrame}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality"
                           SnapsToDevicePixels="True"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="YOLO MONITOR"
                               Style="{StaticResource CardTitleStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Latest detection"
                                       Style="{StaticResource CompactStatusLabel}"
                                       Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding DetectionSummary}"
                                       TextWrapping="Wrap"
                                       FontSize="24"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <Separator Margin="0,0,0,12"/>
                            <TextBlock Text="Preview camera in monitor-only mode"
                                       FontSize="21"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastError, StringFormat=Last error: {0}}"
                                       FontSize="21"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Separator Margin="0,0,0,12"/>

                        <Button Content="Manual Dofbot"
                                Click="OpenRobotDiagnostics_Click"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                ToolTip="Open manual servo calibration in a separate maintenance window. No diagnostic polling runs while the window is closed."/>

                        <Button Content="HOME ROBOT"
                                Command="{Binding HomeCommand}"
                                IsEnabled="{Binding IsConnected}"
                                Style="{StaticResource NeutralButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                ToolTip="Move DOFBOT to the calibrated HOME pose. The Robot API rejects this request while a motion job is busy."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Start camera"
                                    Command="{Binding StartVisionCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,5,0"/>
                            <Button Grid.Column="1"
                                    Content="Stop"
                                    Command="{Binding StopVisionCommand}"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
