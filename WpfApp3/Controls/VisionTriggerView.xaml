<UserControl x:Class="WpfApp3.Controls.VisionTriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="VisionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DOFBOT camera / Vision API"
                               Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Text="Jetson API address"
                               Style="{DynamicResource LabelStyle}"/>
                    <TextBox Text="{Binding RobotBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource VisionTextBoxStyle}"
                             Height="34"
                             Margin="0,4,12,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            Style="{DynamicResource PrimaryButton}"
                            Width="100"
                            Margin="0,0,8,0"/>
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            Style="{DynamicResource NeutralButton}"
                            Width="110"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Connection" Style="{DynamicResource LabelStyle}"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{DynamicResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Vision running" Style="{DynamicResource LabelStyle}"/>
                    <TextBlock Text="{Binding VisionRunning}" Style="{DynamicResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Camera open" Style="{DynamicResource LabelStyle}"/>
                    <TextBlock Text="{Binding CameraOpen}" Style="{DynamicResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Robot ready" Style="{DynamicResource LabelStyle}"/>
                    <TextBlock Text="{Binding RobotReady}" Style="{DynamicResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Auto trigger" Style="{DynamicResource LabelStyle}"/>
                    <TextBlock Text="{Binding AutomaticTriggerActive}" Style="{DynamicResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Text="Trigger latched" Style="{DynamicResource LabelStyle}"/>
                    <TextBlock Text="{Binding TriggerLatched}" Style="{DynamicResource ValueStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{DynamicResource CardStyle}"
                    Padding="0"
                    Margin="0,0,12,12">
                <Grid Background="#181818">
                    <TextBlock Text="Start vision monitoring to view the DOFBOT camera"
                               Foreground="{DynamicResource HintText}"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image Source="{Binding RemoteFrame}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Border Background="#D91B1B1B"
                            CornerRadius="4"
                            Padding="8"
                            Margin="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock Text="{Binding DetectionSummary}"
                                       Foreground="{DynamicResource SuccessColor}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TriggerSummary}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding JobSummary}"
                                       Foreground="{DynamicResource HintText}"
                                       Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding RoutingSummary}"
                                       Foreground="{DynamicResource WarningColor}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{DynamicResource CardStyle}"
                    Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="AI result + trigger routing"
                                   Style="{DynamicResource CardTitleStyle}"/>
                        <TextBlock Text="FIFO keeps each IMITECH classification paired with the next battery detected by the DOFBOT camera."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource HintText}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="The Windows AI service will enqueue one result per battery. These controls provide the same contract for integration testing."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource HintText}"
                                   FontSize="11"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Test class" Style="{DynamicResource LabelStyle}"/>
                        <ComboBox SelectedValue="{Binding SelectedTestClass}"
                                  SelectedValuePath="Content"
                                  Margin="0,3,0,6">
                            <ComboBoxItem Content="dented"/>
                            <ComboBoxItem Content="normal"/>
                            <ComboBoxItem Content="scratched"/>
                            <ComboBoxItem Content="swollen"/>
                        </ComboBox>
                        <TextBlock Text="Confidence (0..1)" Style="{DynamicResource LabelStyle}"/>
                        <TextBox Text="{Binding TestConfidence, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource VisionTextBoxStyle}"
                                 Margin="0,3,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Enqueue test result"
                                    Command="{Binding EnqueueTestClassificationCommand}"
                                    Style="{DynamicResource SuccessButton}"/>
                            <Button Grid.Column="2"
                                    Content="Clear queue"
                                    Command="{Binding ClearClassificationQueueCommand}"
                                    Style="{DynamicResource NeutralButton}"/>
                        </Grid>
                        <TextBlock Text="{Binding AiQueueSize, StringFormat=Queued results: {0}}"
                                   Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding NextAiResult, StringFormat=Next: {0}}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SuccessColor}"
                                   Margin="0,2,0,6"/>
                        <TextBlock Text="dented / scratched / swollen → robot pick; normal → PASS"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningColor}"
                                   FontSize="11"
                                   Margin="0,0,0,12"/>

                        <Separator Margin="0,0,0,10"/>
                        <TextBlock Text="Trigger timing"
                                   Style="{DynamicResource CardTitleStyle}"/>

                        <TextBlock Text="Belt speed (mm/s)" Style="{DynamicResource LabelStyle}"/>
                        <TextBox Text="{Binding BeltSpeedMmS, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource VisionTextBoxStyle}"
                                 Margin="0,3,0,9"/>

                        <TextBlock Text="Camera-to-pick distance (mm)" Style="{DynamicResource LabelStyle}"/>
                        <TextBox Text="{Binding DistanceToPickMm, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource VisionTextBoxStyle}"
                                 Margin="0,3,0,9"/>

                        <TextBlock Text="Robot time to grip (ms)" Style="{DynamicResource LabelStyle}"/>
                        <TextBox Text="{Binding RobotTimeToGripMs, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource VisionTextBoxStyle}"
                                 Margin="0,3,0,9"/>

                        <TextBlock Text="Processing margin (ms)" Style="{DynamicResource LabelStyle}"/>
                        <TextBox Text="{Binding ProcessingMarginMs, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource VisionTextBoxStyle}"
                                 Margin="0,3,0,9"/>

                        <CheckBox Content="Enable automatic robot trigger"
                                  IsChecked="{Binding AutomaticTriggerRequested}"
                                  Foreground="{DynamicResource DangerColor}"
                                  FontWeight="SemiBold"
                                  Margin="0,5,0,10"/>

                        <Button Content="Apply timing and mode"
                                Command="{Binding ApplyTimingConfigCommand}"
                                Style="{DynamicResource PrimaryButton}"/>

                        <TextBlock Text="{Binding TimingSummary}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding LastError, StringFormat=Last error: {0}}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerColor}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Style="{DynamicResource CardStyle}"
                Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="VISION HOME"
                            Command="{Binding VisionHomeCommand}"
                            Style="{DynamicResource PrimaryButton}"
                            Width="125"
                            Margin="0,0,8,0"/>
                    <Button Content="Start monitoring"
                            Command="{Binding StartVisionCommand}"
                            Style="{DynamicResource SuccessButton}"
                            Width="130"
                            Margin="0,0,8,0"/>
                    <Button Content="Stop"
                            Command="{Binding StopVisionCommand}"
                            Style="{DynamicResource DangerButton}"
                            Width="90"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding FrameCount, StringFormat=Frames processed: {0}}"
                           Style="{DynamicResource LabelStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding StableCount, StringFormat=Stable frames: {0}}"
                               Style="{DynamicResource LabelStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button Content="Reset trigger"
                            Command="{Binding ResetTriggerCommand}"
                            Style="{DynamicResource NeutralButton}"
                            Width="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
