<UserControl x:Class="WpfApp3.Controls.SystemStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D30" CornerRadius="8" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="System Status"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="14"
                       FontWeight="Bold"
                       Padding="12,10,12,8"
                       Background="#1E1E1E"/>

            <!-- Status Items -->
            <Grid Grid.Row="1" Background="#252526" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Camera Status -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,12,12" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CameraIndicator"
                                Background="#4EC9B0"
                                CornerRadius="4"
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Camera" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- AI Status -->
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AIIndicator"
                                Background="#4EC9B0"
                                CornerRadius="4"
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="AI" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Robot Status -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,12,12" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="RobotIndicator"
                                Background="#4EC9B0"
                                CornerRadius="4"
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Robot" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Arduino Status -->
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ArduinoIndicator"
                                Background="#4EC9B0"
                                CornerRadius="4"
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Arduino" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Conveyor Status -->
                <Border Grid.Row="2" Grid.Column="0" Padding="0,0,12,0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ConveyorIndicator"
                                Background="#4EC9B0"
                                CornerRadius="4"
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Conveyor" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Power Status -->
                <Border Grid.Row="2" Grid.Column="1" Padding="0,0,0,0" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PowerIndicator"
                                Background="#4EC9B0"
                                CornerRadius="4"
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Power" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
