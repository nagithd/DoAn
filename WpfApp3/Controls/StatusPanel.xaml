<UserControl x:Class="WpfApp3.Controls.StatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D30" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       x:Name="HeaderTitle"
                       Text="System Status"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="13"
                       FontWeight="Bold"
                       Padding="12,10,12,8"
                       Background="#1E1E1E"/>

            <!-- Status Content -->
            <Grid Grid.Row="1" Background="#252526">
                <StackPanel VerticalAlignment="Top" Margin="12">
                    <!-- Status Item 1 -->
                    <Border BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="System" Foreground="#858585" FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#4EC9B0" CornerRadius="4" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ready" Foreground="#CCCCCC" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Item 2 -->
                    <Border BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Robot" Foreground="#858585" FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#4EC9B0" CornerRadius="4" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Operational" Foreground="#CCCCCC" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Item 3 -->
                    <Border BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AI Engine" Foreground="#858585" FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#4EC9B0" CornerRadius="4" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Active" Foreground="#CCCCCC" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Item 4 -->
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Temperature" Foreground="#858585" FontSize="10" Margin="0,0,0,4"/>
                        <TextBlock Text="45°C" Foreground="#CCCCCC" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
