<UserControl x:Class="WpfApp3.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent">
    <Border Background="{DynamicResource CardBackgroundColor}" CornerRadius="6" Padding="10" Margin="4" BorderBrush="#3E3E42" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Grid used for stable resizing: Icon column + Content column -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="IconBlock" Text="📊" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0"/>

            <!-- Content -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LabelBlock" Text="Label" Style="{DynamicResource SmallLabelStyle}" Grid.Row="0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ValueBlock" Text="0" Style="{DynamicResource MetricValueStyle}" Grid.Row="1" Margin="0,2,0,0"/>
                <TextBlock x:Name="TrendBlock" Text="+0" Grid.Row="2" Style="{DynamicResource SmallLabelStyle}" Foreground="{DynamicResource AccentColor}" FontSize="10"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
