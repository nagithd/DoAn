<UserControl x:Class="WpfApp3.Controls.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent">
    <Border Background="#2D2D30"
            CornerRadius="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid Background="#181818">
            <TextBlock Text="No live frame from the Windows camera"
                       Foreground="#858585"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Image x:Name="CameraImage"
                   Source="{Binding CameraFrame}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <Border Background="#CC1B1B1B"
                    CornerRadius="4"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IMITECH / Windows"
                               Foreground="#CCCCCC"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CameraStatus, StringFormat= • {0}}"
                               Foreground="#4EC9B0"
                               FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Background="#CC1B1B1B"
                    CornerRadius="4"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CameraResolution}"
                               Foreground="#CCCCCC"
                               FontSize="11"/>
                    <TextBlock Text="{Binding CameraFrameRate, StringFormat= @ {0:0.#} fps}"
                               Foreground="#858585"
                               FontSize="11"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
