<UserControl x:Class="WpfApp3.Controls.StatisticsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D30" CornerRadius="6" Margin="8" HorizontalAlignment="Stretch">
        <Grid Margin="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Icon -->
                <TextBlock x:Name="IconBlock"
                           Text="📊"
                           FontSize="28"
                           TextAlignment="Center"
                           Foreground="#4EC9B0"
                           Margin="0,0,0,8"/>

                <!-- Label -->
                <TextBlock x:Name="LabelBlock"
                           Text="Good"
                           Foreground="#858585"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- Count/Value -->
                <TextBlock x:Name="ValueBlock"
                           Text="2,847"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- Change/Trend -->
                <TextBlock x:Name="TrendBlock"
                           Text="↑ 12 today"
                           Foreground="#4EC9B0"
                           FontSize="10"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
