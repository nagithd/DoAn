<UserControl x:Class="WpfApp3.Controls.RobotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D30" CornerRadius="8" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Robot Panel"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="14"
                       FontWeight="Bold"
                       Padding="12,10,12,8"
                       Background="#1E1E1E"/>

            <!-- Cards Grid -->
            <Grid Grid.Row="1" Background="#252526" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Robot Status Card -->
                <Border Grid.Row="0" Grid.Column="0" Background="#2D2D30" CornerRadius="6" Margin="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Robot Status" Foreground="#858585" FontSize="10" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#4EC9B0" CornerRadius="4" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                       <TextBlock x:Name="RobotStatusValue" Text="Operational" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Current Position Card -->
                <Border Grid.Row="0" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Margin="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Current Position" Foreground="#858585" FontSize="10" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CurrentPositionValue" Text="X: 0.0, Y: 0.0, Z: 0.0" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Current Action Card -->
                <Border Grid.Row="1" Grid.Column="0" Background="#2D2D30" CornerRadius="6" Margin="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Current Action" Foreground="#858585" FontSize="10" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CurrentActionValue" Text="Idle" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Target Bin Card -->
                <Border Grid.Row="1" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Margin="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Target Bin" Foreground="#858585" FontSize="10" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TargetBinValue" Text="Bin-001" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Robot Temperature Card -->
                <Border Grid.Row="2" Grid.Column="0" Background="#2D2D30" CornerRadius="6" Margin="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Robot Temperature" Foreground="#858585" FontSize="10" Margin="0,0,0,6"/>
                        <StackPanel>
                            <TextBlock x:Name="TemperatureValue" Text="45.2°C" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="TemperatureBar" Background="#3E3E42" Foreground="#4EC9B0" Height="4" Margin="0,4,0,0" Value="45" Maximum="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Servo Status Card -->
                <Border Grid.Row="2" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Margin="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Servo Status" Foreground="#858585" FontSize="10" Margin="0,0,0,6"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Servo 1: " Foreground="#858585" FontSize="11"/>
                                <Border x:Name="ServoStatus1" Background="#4EC9B0" CornerRadius="3" Width="8" Height="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Servo 2: " Foreground="#858585" FontSize="11"/>
                                <Border x:Name="ServoStatus2" Background="#4EC9B0" CornerRadius="3" Width="8" Height="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Servo 3: " Foreground="#858585" FontSize="11"/>
                                <Border x:Name="ServoStatus3" Background="#4EC9B0" CornerRadius="3" Width="8" Height="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
