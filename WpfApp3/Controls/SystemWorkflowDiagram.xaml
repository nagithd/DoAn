<UserControl x:Class="WpfApp3.Controls.SystemWorkflowDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="BlockStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="BlockTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0">
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both"
                 Margin="10">
            <Canvas Width="1200"
                    Height="430"
                    Background="{StaticResource CardBackground}">

                <!-- Main software nodes -->
                <Border Canvas.Left="460" Canvas.Top="25"
                        Width="280" Height="72"
                        Style="{StaticResource BlockStyle}">
                    <TextBlock Text="CONTROL PC"
                               Style="{StaticResource BlockTextStyle}"
                               FontSize="20"/>
                </Border>

                <Border Canvas.Left="135" Canvas.Top="145"
                        Width="235" Height="80"
                        Style="{StaticResource BlockStyle}"
                        BorderBrush="{StaticResource DangerBrush}">
                    <TextBlock Text="JETSON + DOFBOT"
                               Style="{StaticResource BlockTextStyle}"/>
                </Border>

                <Border Canvas.Left="480" Canvas.Top="145"
                        Width="250" Height="80"
                        Style="{StaticResource BlockStyle}">
                    <TextBlock Text="CAMERA"
                               Style="{StaticResource BlockTextStyle}"/>
                </Border>

                <Border Canvas.Left="930" Canvas.Top="145"
                        Width="180" Height="80"
                        Style="{StaticResource BlockStyle}"
                        BorderBrush="{StaticResource WarningBrush}">
                    <TextBlock Text="ARDUINO"
                               Style="{StaticResource BlockTextStyle}"/>
                </Border>

                <!-- PC -> Jetson/DOFBOT over HTTP -->
                <Path Data="M 460,61 L 252,61 L 252,132"
                      Stroke="{StaticResource DangerBrush}"
                      StrokeThickness="3"
                      Fill="Transparent"/>
                <Polygon Points="252,145 244,130 260,130"
                         Fill="{StaticResource DangerBrush}"/>
                <TextBlock Canvas.Left="320" Canvas.Top="48"
                           Text="HTTP"
                           Style="{StaticResource LinkTextStyle}"/>

                <!-- PC -> camera control and camera -> PC frames use separate arrows. -->
                <Line X1="585" Y1="97" X2="585" Y2="145"
                      Stroke="{StaticResource AccentColor}"
                      StrokeThickness="3"/>
                <Polygon Points="585,145 577,130 593,130"
                         Fill="{StaticResource AccentColor}"/>
                <Line X1="615" Y1="145" X2="615" Y2="97"
                      Stroke="{StaticResource AccentColor}"
                      StrokeThickness="3"/>
                <Polygon Points="615,97 607,112 623,112"
                         Fill="{StaticResource AccentColor}"/>
                <TextBlock Canvas.Left="627" Canvas.Top="110"
                           Text="GigE"
                           Style="{StaticResource LinkTextStyle}"/>

                <!-- PC <-> Arduino USB serial -->
                <Path Data="M 740,61 L 1020,61 L 1020,145"
                      Stroke="{StaticResource WarningBrush}"
                      StrokeThickness="3"
                      Fill="Transparent"/>
                <Polygon Points="740,61 755,53 755,69"
                         Fill="{StaticResource WarningBrush}"/>
                <Polygon Points="1020,145 1012,130 1028,130"
                         Fill="{StaticResource WarningBrush}"/>
                <TextBlock Canvas.Left="850" Canvas.Top="48"
                           Text="USB SERIAL"
                           Style="{StaticResource LinkTextStyle}"/>

                <!-- Conveyor -->
                <Rectangle Canvas.Left="75" Canvas.Top="285"
                           Width="1050" Height="82"
                           RadiusX="5" RadiusY="5"
                           Fill="{StaticResource WindowBackground}"
                           Stroke="{StaticResource BorderBrushColor}"
                           StrokeThickness="1"/>
                <Line X1="1100" Y1="326" X2="105" Y2="326"
                      Stroke="{StaticResource SecondaryText}"
                      StrokeThickness="2"
                      StrokeDashArray="9,5"/>
                <Polygon Points="92,326 110,317 110,335"
                         Fill="{StaticResource SecondaryText}"/>

                <!-- Physical checkpoints are zones on the conveyor. -->
                <Border Canvas.Left="167" Canvas.Top="294"
                        Width="170" Height="64"
                        Style="{StaticResource BlockStyle}"
                        BorderBrush="{StaticResource DangerBrush}"
                        Background="{StaticResource CardBackground}">
                    <TextBlock Text="ROBOT&#x0a;CHECKPOINT"
                               Style="{StaticResource BlockTextStyle}"
                               FontSize="15"/>
                </Border>

                <Border Canvas.Left="525" Canvas.Top="294"
                        Width="160" Height="64"
                        Style="{StaticResource BlockStyle}"
                        Background="{StaticResource CardBackground}">
                    <TextBlock Text="CAMERA&#x0a;CHECKPOINT"
                               Style="{StaticResource BlockTextStyle}"
                               FontSize="15"/>
                </Border>

                <Border Canvas.Left="950" Canvas.Top="299"
                        Width="105" Height="54"
                        Style="{StaticResource BlockStyle}"
                        BorderBrush="{StaticResource WarningBrush}"
                        Background="{StaticResource CardBackground}">
                    <TextBlock Text="SENSOR"
                               Style="{StaticResource BlockTextStyle}"
                               FontSize="15"/>
                </Border>


                <!-- Camera and robot are physically aligned with their zones. -->
                <Line X1="252" Y1="225" X2="252" Y2="294"
                      Stroke="{StaticResource DangerBrush}"
                      StrokeThickness="2"
                      StrokeDashArray="6,4"/>
                <Line X1="605" Y1="225" X2="605" Y2="294"
                      Stroke="{StaticResource AccentColor}"
                      StrokeThickness="2"
                      StrokeDashArray="6,4"/>

                <!-- Sensor event to Arduino. -->
                <Path Data="M 1020,300 L 1020,225"
                      Stroke="{StaticResource WarningBrush}"
                      StrokeThickness="3"
                      Fill="Transparent"/>
                <Polygon Points="1020,225 1012,240 1028,240"
                         Fill="{StaticResource WarningBrush}"/>

                <!-- Motor is attached directly to the conveyor frame. -->
                <Border Canvas.Left="955" Canvas.Top="365"
                        Width="155" Height="48"
                        Style="{StaticResource BlockStyle}"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        Background="{StaticResource WindowBackground}"
                        Padding="4">
                    <TextBlock Text="DC MOTOR / PWM"
                               Style="{StaticResource BlockTextStyle}"
                               FontSize="14"/>
                </Border>
                <Path Data="M 1109,200 L 1140,200 L 1140,391 L 1111,391"
                      Stroke="{StaticResource WarningBrush}"
                      StrokeThickness="3"
                      Fill="Transparent"/>
                <Polygon Points="1108,391 1124,383 1124,399"
                         Fill="{StaticResource WarningBrush}"/>
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>
