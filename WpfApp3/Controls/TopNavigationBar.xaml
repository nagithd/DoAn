<UserControl x:Class="WpfApp3.Controls.TopNavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="1400"
             Background="#252526"
             BorderThickness="0,0,0,2"
             BorderBrush="#3E3E42">

    <UserControl.Resources>
        <!-- Status Indicator Style -->
        <Style x:Key="StatusIndicatorStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Emergency Stop Button Style -->
        <Style x:Key="EmergencyStopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A92222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7A1818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info Item Style -->
        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Grid -->
    <Grid Margin="15,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>          <!-- Logo -->
            <ColumnDefinition Width="Auto"/>          <!-- Title -->
            <ColumnDefinition Width="*"/>             <!-- Spacer -->
            <ColumnDefinition Width="Auto"/>          <!-- Center Status Items -->
            <ColumnDefinition Width="*"/>             <!-- Spacer -->
            <ColumnDefinition Width="Auto"/>          <!-- Right Items -->
        </Grid.ColumnDefinitions>

        <!-- ========== LEFT SECTION: Logo & Title ========== -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
            <!-- Application Logo -->
            <TextBlock Text="⚙" FontSize="28" Foreground="#007ACC" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- Application Title -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock Text="Battery Inspection System" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SecondaryText}"/>
                <TextBlock Text="v1.0.0" FontSize="9" Foreground="{StaticResource HintText}"/>
            </StackPanel>
        </StackPanel>

        <!-- Center status removed as requested -->
        <Grid Grid.Column="3" />

        <!-- ========== RIGHT SECTION: Controls ========== -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Emergency Stop Button (user info removed) -->
            <Button x:Name="EmergencyStopButton"
                    Content="🛑 EMERGENCY STOP"
                    Style="{StaticResource EmergencyStopButtonStyle}"
                    ToolTip="Press to initiate emergency stop sequence"/>
        </StackPanel>
    </Grid>
</UserControl>
